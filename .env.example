# ==========================================
# Telegram VPN Config Monitor - Environment
# ==========================================

# Telegram MTProto API credentials (get from https://my.telegram.org)
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash_here

# Telegram User Session String (generate using: npm run auth)
TELEGRAM_SESSION=

# Target channel where healthy VPN configs will be published (e.g. @my_vpn_channel or -1001234567890)
TARGET_CHANNEL_ID=@connexy_private

# Scan interval in minutes (default: 10)
SCAN_INTERVAL_MINUTES=10

# Max messages to fetch per channel on initial scan (default: 30)
INITIAL_CHANNEL_SCAN_LIMIT=30

# Max messages to fetch per channel on subsequent scans (default: 50)
SUBSEQUENT_CHANNEL_SCAN_LIMIT=50

# Concurrency limit for testing configs in parallel (default: 5)
TESTER_CONCURRENCY=5

# Timeout in milliseconds for each config test (default: 5000)
TESTER_TIMEOUT_MS=5000

# Tester mode: "xray" (deep proxy test via Xray-core) or "tcp" (fast TCP/TLS ping)
# If xray is selected and binary is not found, it will automatically download the official xray binary
TESTER_MODE=xray

# URL used to verify internet connectivity through the proxy
TESTER_PING_URL=http://cp.cloudflare.com/generate_204

# Maximum acceptable latency in milliseconds (configs with higher ping are rejected, default: 3500)
MAX_HEALTHY_LATENCY_MS=3500

# Maximum healthy configs to post per scan cycle (default: 5)
MAX_POSTS_PER_CYCLE=5

# Comma-separated list of channel usernames or IDs to scan (e.g. proxy_changgel,vpn_ir_f,xxx)
# If set, ONLY these channels will be scanned. If left empty, all joined channels are scanned.
ALLOWED_CHANNELS=proxy_changgel,vpn_ir_f,xxx

# Optional: Comma-separated list of channel IDs or usernames to IGNORE
EXCLUDED_CHANNELS=

# Custom remarks/name to replace after # for all configs (default: @connexy_private)
CUSTOM_CONFIG_REMARKS=@connexy_private

# Include ping latency in the channel post: true or false (default: false)
INCLUDE_PING_IN_POST=false

# Optional: Telegram Bot API Token from @BotFather for interactive bot commands (/scan, /status, /channels)
TELEGRAM_BOT_TOKEN=

# Optional: Comma-separated list of Telegram User IDs allowed to use bot commands (leave empty for public)
ADMIN_USER_IDS=8344382195

# Database path (default: ./data/vpn_monitor.sqlite)
DATABASE_PATH=./data/vpn_monitor.sqlite

# Logging level: trace, debug, info, warn, error (default: info)
LOG_LEVEL=info
