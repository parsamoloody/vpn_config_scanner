{
  "name": "vpn-config-monitor",
  "version": "1.0.0",
  "description": "Telegram VPN config monitoring bot using GramJS, SQLite, and dual-tier proxy tester",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc",
    "auth": "tsx src/telegram/auth.ts",
    "test": "tsx --test test/**/*.test.ts",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "telegram",
    "vpn",
    "vless",
    "vmess",
    "trojan",
    "shadowsocks",
    "proxy-tester",
    "xray"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^11.8.1",
    "dotenv": "^16.4.7",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "socks-proxy-agent": "^8.0.5",
    "telegram": "^2.26.22",
    "undici": "^7.3.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.13.5",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
